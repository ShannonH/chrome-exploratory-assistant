{
  "manifest_version": 3,
  "name": "Exploratory Testing Assistant",
  "version": "1.0",
  "description": "Document test cases, take screenshots, and export test results during exploratory testing",
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Exploratory Testing Assistant - Open in Sidebar",
    "default_icon": {
      "16": "icons/super-qa.png",
      "32": "icons/super-qa.png",
      "48": "icons/super-qa.png",
      "128": "icons/super-qa.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/super-qa.png",
    "32": "icons/super-qa.png",
    "48": "icons/super-qa.png",
    "128": "icons/super-qa.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "open-testing-assistant": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "Open Testing Assistant"
    },
    "take-screenshot": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Take Screenshot"
    },
    "mark-pass": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Mark Current Step as Pass"
    },
    "mark-fail": {
      "suggested_key": {
        "default": "Alt+F"
      },
      "description": "Mark Current Step as Fail"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["overlay.html", "overlay.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}